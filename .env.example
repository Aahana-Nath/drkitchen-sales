# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
NEXT_PUBLIC_LOCAL_DEMO_MODE=false

# Server-only SMTP settings for manager reminder emails (never use NEXT_PUBLIC_ here)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=YOUR-SENDER-GMAIL@gmail.com
SMTP_PASSWORD=YOUR-GOOGLE-APP-PASSWORD
SMTP_FROM_EMAIL=YOUR-SENDER-GMAIL@gmail.com
SMTP_FROM_NAME=DrKitchen Sales
